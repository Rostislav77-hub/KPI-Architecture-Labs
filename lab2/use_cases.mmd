flowchart LR
    %% Актори
    Player([Player])
    PaymentGateway([Payment Gateway])

    %% Use Cases
    UC1((Купити предмет))
    UC2((Перевірити баланс))
    UC3((Поповнити баланс))
    UC4((Продати предмет))

